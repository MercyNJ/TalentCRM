@page
@model TalentCRM.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
}

<div class="page-head">
    <h1>Clients <span class="count">@Model.Clients.Count</span></h1>
    <a class="btn btn-primary" asp-page="Edit">+ New client</a>
</div>

<form method="get" class="filters">
    <input asp-for="Search" placeholder="Search company, industry or location" />
    <button class="btn" type="submit">Filter</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a class="btn btn-link" asp-page="Index">Clear</a>
    }
</form>

@if (Model.Clients.Count == 0)
{
    <div class="card"><p class="muted">No clients found.</p></div>
}
else
{
    <div class="card table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Industry</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th class="num">Open jobs</th>
                    <th class="num">All jobs</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Clients)
                {
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@row.Client.Id"><strong>@row.Client.CompanyName</strong></a></td>
                        <td>@row.Client.Industry</td>
                        <td>@row.Client.ContactName<br /><span class="small muted">@row.Client.ContactEmail</span></td>
                        <td>@row.Client.Location</td>
                        <td class="num">@row.OpenJobs</td>
                        <td class="num">@row.TotalJobs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
