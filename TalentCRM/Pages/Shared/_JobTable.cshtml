@* A reusable table of jobs (used by Jobs/Index and Clients/Details). *@
@model List<JobRow>

@if (Model.Count == 0)
{
    <p class="muted">No jobs yet.</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Client</th>
                    <th>Type</th>
                    <th>Salary</th>
                    <th class="num">Filled</th>
                    <th class="num">Applicants</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <a asp-page="/Jobs/Details" asp-route-id="@row.Job.Id"><strong>@row.Job.Title</strong></a><br />
                            <span class="small muted">@row.Job.Location</span>
                        </td>
                        <td><a asp-page="/Clients/Details" asp-route-id="@row.Client.Id">@row.Client.CompanyName</a></td>
                        <td>@row.Job.EmploymentType.ToDisplay()</td>
                        <td class="small">@row.Job.SalaryText</td>
                        <td class="num">@row.Hired / @row.Job.Openings</td>
                        <td class="num">@row.Applicants</td>
                        <td><span class="@row.Job.Status.BadgeClass()">@row.Job.Status.ToDisplay()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
