@page "{id:int}"
@model TalentCRM.Pages.Candidates.DetailsModel
@{
    var c = Model.Candidate;
    ViewData["Title"] = c.FullName;
}

<p class="crumbs"><a asp-page="Index">Candidates</a> /</p>
<div class="page-head">
    <div>
        <h1>@c.FullName <span class="@c.Status.BadgeClass()">@c.Status.ToDisplay()</span></h1>
        <p class="muted">@c.YearsOfExperience years' experience@(c.Location is null ? "" : $" · {c.Location}")</p>
    </div>
    <div class="actions">
        <a class="btn" asp-page="Edit" asp-route-id="@c.Id">Edit</a>
        <a class="btn btn-primary" asp-page="/Applications/Create" asp-route-candidateId="@c.Id">+ Add to a job</a>
    </div>
</div>

<div class="grid-2">
    <section class="card">
        <h2>Contact</h2>
        <dl class="facts">
            <dt>Email</dt><dd>@c.Email</dd>
            <dt>Phone</dt><dd>@(c.Phone ?? "—")</dd>
            <dt>Location</dt><dd>@(c.Location ?? "—")</dd>
            <dt>Added</dt><dd>@c.CreatedAt.ToString("d MMM yyyy")</dd>
        </dl>
    </section>
    <section class="card">
        <h2>Skills</h2>
        @if (c.SkillList.Count == 0)
        {
            <p class="muted">No skills listed.</p>
        }
        <div class="tags">
            @foreach (var skill in c.SkillList)
            {
                <a class="tag" asp-page="Index" asp-route-search="@skill">@skill</a>
            }
        </div>
    </section>
</div>

<section class="card">
    <h2>Applications</h2>
    <partial name="_ApplicationTable" model="Model.Applications" />
</section>

<form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="danger-zone"
      onsubmit="return confirm('Delete this candidate? This cannot be undone.');">
    <button type="submit" class="btn btn-danger">Delete candidate</button>
    <span class="small muted">Only possible when they have no active applications.</span>
</form>
